<?xml version="1.0" encoding="utf-8"?>
<!-- Settings panel. Colors come from Theme.ApplyTo as dynamic resources. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
      TextElement.FontSize="13.5"
      TextElement.Foreground="{DynamicResource Fg1}">
  <Grid.Resources>

    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,22,0,8"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
    </Style>

    <Style x:Key="Separator" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource CardStroke}"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg1}"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>

    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Width" Value="48"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="40" Height="20" Background="Transparent">
              <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                      BorderBrush="{DynamicResource TrackStroke}" Background="{DynamicResource ControlBg}"/>
              <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource Fg2}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                <Setter TargetName="Knob" Property="Margin" Value="24,0,0,0"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Knob" Property="Width" Value="14"/>
                <Setter TargetName="Knob" Property="Height" Value="14"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="RailFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource Accent}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RailEmpty" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource TrackRail}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="20" Height="20" Background="Transparent">
              <Ellipse Fill="{DynamicResource ThumbBg}" Stroke="{DynamicResource ControlStroke}" StrokeThickness="1"/>
              <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Width" Value="13"/>
                <Setter TargetName="Dot" Property="Height" Value="13"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Dot" Property="Width" Value="8"/>
                <Setter TargetName="Dot" Property="Height" Value="8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FluentSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="170"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track" Height="24">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource RailFill}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource RailEmpty}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Segmented choice -->
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="4" Padding="12,4,12,5" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThumbBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg1}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Screen corner picker -->
    <Style x:Key="Corner" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg3}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Width="46" Height="30" CornerRadius="5" Margin="6,0,0,0" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="12"/>
      <Setter Property="MinWidth" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Bar" Width="4" CornerRadius="2" HorizontalAlignment="Center" Background="{DynamicResource TrackRail}"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bar" Property="Width" Value="6"/>
                          <Setter TargetName="Bar" Property="CornerRadius" Value="3"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg1}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Padding="16,6,16,7" MinWidth="96" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Padding="16,6,16,7" MinWidth="96" BorderThickness="1"
                    BorderBrush="{DynamicResource Accent}" Background="{DynamicResource Accent}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid.RowDefinitions>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,18,24,6">

      <StackPanel Orientation="Horizontal">
        <Image x:Name="Logo" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Paramètres" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Les modifications s'appliquent en direct sur la notification." Style="{StaticResource Hint}"/>
        </StackPanel>
      </StackPanel>

      <!-- Appearance -->
      <TextBlock Text="Apparence" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Thème" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <Border Grid.Column="1" CornerRadius="6" Padding="2" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeAuto" GroupName="Theme" Content="Système" Style="{StaticResource Segment}"/>
                <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Clair" Style="{StaticResource Segment}"/>
                <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Sombre" Style="{StaticResource Segment}"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <StackPanel Margin="16,12">
            <TextBlock Text="Couleur d'accent" Style="{StaticResource Label}"/>
            <WrapPanel x:Name="AccentSwatches" Margin="-3,8,0,0"/>
          </StackPanel>
          <Border Style="{StaticResource Separator}"/>
          <StackPanel Margin="16,12">
            <TextBlock Text="Teinte du fond" Style="{StaticResource Label}"/>
            <WrapPanel x:Name="TintSwatches" Margin="-3,8,0,0"/>
          </StackPanel>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Opacité du fond" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="15" Maximum="100" Style="{StaticResource FluentSlider}"/>
            <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource Value}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Effet acrylique" Style="{StaticResource Label}"/>
              <TextBlock Text="Floute ce qui se trouve derrière la notification" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="BlurSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
          <Border x:Name="RoundedSeparator" Style="{StaticResource Separator}"/>
          <Grid x:Name="RoundedRow" Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Coins arrondis" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <CheckBox x:Name="RoundedSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Size and position -->
      <TextBlock Text="Taille et position" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Taille" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="160" Style="{StaticResource FluentSlider}"/>
            <TextBlock x:Name="ScaleValue" Grid.Column="2" Style="{StaticResource Value}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Largeur" Style="{StaticResource Label}" VerticalAlignment="Center"/>
            <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="260" Maximum="600" Style="{StaticResource FluentSlider}"/>
            <TextBlock x:Name="WidthValue" Grid.Column="2" Style="{StaticResource Value}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Position" Style="{StaticResource Label}"/>
              <TextBlock x:Name="PositionHint" Style="{StaticResource Hint}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <RadioButton x:Name="PosTopLeft" GroupName="Pos" Style="{StaticResource Corner}" ToolTip="En haut à gauche">
                <Border Width="14" Height="8" CornerRadius="2" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </RadioButton>
              <RadioButton x:Name="PosTopRight" GroupName="Pos" Style="{StaticResource Corner}" ToolTip="En haut à droite">
                <Border Width="14" Height="8" CornerRadius="2" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </RadioButton>
              <RadioButton x:Name="PosBottomLeft" GroupName="Pos" Style="{StaticResource Corner}" ToolTip="En bas à gauche">
                <Border Width="14" Height="8" CornerRadius="2" Margin="5" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </RadioButton>
              <RadioButton x:Name="PosBottomRight" GroupName="Pos" Style="{StaticResource Corner}" ToolTip="En bas à droite">
                <Border Width="14" Height="8" CornerRadius="2" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              </RadioButton>
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Éviter les autres notifications" Style="{StaticResource Label}"/>
              <TextBlock Text="Se décale pour ne pas recouvrir les notifications de Windows, Element, Teams…" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="AvoidSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <DockPanel Margin="16,11,16,12">
            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                       Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentText}"/>
            <TextBlock Style="{StaticResource Hint}" Margin="0"
                       Text="Faites glisser la notification affichée à l'écran pour la placer où vous voulez, et ses poignées pour la redimensionner."/>
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Content -->
      <TextBlock Text="Contenu" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Réunions du jour" Style="{StaticResource Label}"/>
              <TextBlock Text="Affiche la prochaine réunion au-dessus du message" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="MeetingsSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Aperçu du message" Style="{StaticResource Label}"/>
              <TextBlock Text="Les premières lignes du texte sous l'objet" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="PreviewSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Rappel des messages non lus" Style="{StaticResource Label}"/>
              <TextBlock Text="Réaffiche la notification après sa fermeture tant qu'il reste des messages non lus" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="ReminderSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
          <Grid x:Name="ReminderIntervalRow" Margin="16,0,16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Toutes les" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
            <Border Grid.Column="1" CornerRadius="6" Padding="2" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Remind5" GroupName="Remind" Content="5 min" Style="{StaticResource Segment}"/>
                <RadioButton x:Name="Remind10" GroupName="Remind" Content="10 min" Style="{StaticResource Segment}"/>
                <RadioButton x:Name="Remind15" GroupName="Remind" Content="15 min" Style="{StaticResource Segment}"/>
                <RadioButton x:Name="Remind30" GroupName="Remind" Content="30 min" Style="{StaticResource Segment}"/>
                <RadioButton x:Name="Remind60" GroupName="Remind" Content="1 h" Style="{StaticResource Segment}"/>
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Afficher à l'ouverture de session" Style="{StaticResource Label}"/>
              <TextBlock Text="S'il reste des messages non lus" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="StartupShowSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- System -->
      <TextBlock Text="Système" Style="{StaticResource Section}"/>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Lancer au démarrage de Windows" Style="{StaticResource Label}"/>
              <TextBlock Text="Outlook Notifier démarre avec votre session" Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="LaunchSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
          <Border Style="{StaticResource Separator}"/>
          <Grid Margin="16,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Ouvrir Outlook automatiquement" Style="{StaticResource Label}"/>
              <TextBlock Text="Au démarrage s'il n'est pas ouvert, puis à l'intervalle du rappel si vous le fermez. Outlook s'ouvre réduit." Style="{StaticResource Hint}"/>
            </StackPanel>
            <CheckBox x:Name="AutoOutlookSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

  <DockPanel Grid.Row="1" Margin="24,14,24,20" LastChildFill="False">
    <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Réinitialiser" Style="{StaticResource Btn}"/>
    <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Enregistrer" Margin="8,0,0,0" Style="{StaticResource AccentBtn}"/>
    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Annuler" Style="{StaticResource Btn}"/>
  </DockPanel>
</Grid>
