<?xml version="1.0" encoding="utf-8"?>
<!-- Notification card. Colors come from Theme.ApplyTo as dynamic resources. -->
<StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Margin="6,4,6,6"
            TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">

  <!-- Header: mark, app name ......... unread badge, close -->
  <DockPanel Margin="8,6,0,3" LastChildFill="True">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Border x:Name="UnreadBadge" Height="20" CornerRadius="10" Padding="7,0,8,0" VerticalAlignment="Center"
              Background="{DynamicResource Accent}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10.5" Margin="0,1,5,0"
                     VerticalAlignment="Center" Foreground="{DynamicResource AccentFg}"/>
          <TextBlock x:Name="UnreadText" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentFg}"/>
        </StackPanel>
      </Border>
      <Border x:Name="CloseButton" Width="24" Height="24" CornerRadius="5" Margin="4,0,0,0" Background="Transparent" ToolTip="Fermer">
        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Fg2}"/>
      </Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image x:Name="Logo" Width="14" Height="14" VerticalAlignment="Center"/>
      <TextBlock Text="Outlook" Margin="7,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                 Foreground="{DynamicResource Fg2}"/>
    </StackPanel>
  </DockPanel>

  <!-- Next meeting today -->
  <Border x:Name="MeetingRow" CornerRadius="6" Padding="8,7,8,8" Background="Transparent">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Width="32" Height="32" CornerRadius="8" Margin="0,1,10,0" VerticalAlignment="Top"
              Background="{DynamicResource AccentSoft}">
        <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
      </Border>
      <StackPanel Grid.Column="1">
        <DockPanel>
          <TextBlock x:Name="MeetingWhen" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                     VerticalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
          <TextBlock x:Name="MeetingTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Fg1}"/>
        </DockPanel>
        <TextBlock x:Name="MeetingDetail" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Fg2}"/>
        <Border x:Name="MeetingMore" HorizontalAlignment="Left" Margin="0,6,0,0" CornerRadius="9" Padding="8,2,8,3"
                Background="{DynamicResource Chip}">
          <TextBlock x:Name="MeetingMoreText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Fg2}"/>
        </Border>
      </StackPanel>
    </Grid>
  </Border>

  <Border x:Name="Divider" Height="1" Margin="8,2" Background="{DynamicResource Divider}"/>

  <!-- Latest unread message -->
  <Border x:Name="MailRow" CornerRadius="6" Padding="8,7,8,8" Background="Transparent">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border x:Name="Avatar" Width="32" Height="32" CornerRadius="16" Margin="0,1,10,0" VerticalAlignment="Top">
        <TextBlock x:Name="AvatarText" FontSize="12.5" FontWeight="SemiBold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1">
        <DockPanel>
          <TextBlock x:Name="MailTime" DockPanel.Dock="Right" Margin="8,0,0,0" FontSize="11.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource Fg3}"/>
          <TextBlock x:Name="MailSender" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Fg1}"/>
        </DockPanel>
        <TextBlock x:Name="MailSubject" FontSize="12.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource Fg1}"/>
        <TextBlock x:Name="MailPreview" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   LineStackingStrategy="BlockLineHeight" LineHeight="16" MaxHeight="32"
                   Foreground="{DynamicResource Fg2}"/>
      </StackPanel>
    </Grid>
  </Border>

  <TextBlock x:Name="EmptyText" Margin="8,4,8,8" FontSize="12.5" Foreground="{DynamicResource Fg2}"/>
</StackPanel>
